# AI Service Environment Configuration

APP_NAME=ai-meeting-knowledge-ai-service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Speech-to-Text Model (tiny, base, small, medium, large)
WHISPER_MODEL=tiny

# LLM / OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=60.0
MAX_ANALYSIS_TRANSCRIPT_CHARS=100000

# Vector Indexing / ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=transcript_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_TARGET_SIZE_CHARS=700
CHUNK_MAX_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
INDEXING_TIMEOUT_SECONDS=60.0
